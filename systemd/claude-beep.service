[Unit]
Description=Claude status light in the GNOME top bar
Documentation=file://%h/Documents/home-lab/cpp/ubuntu-claude-beep/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/claude-beep indicator
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
